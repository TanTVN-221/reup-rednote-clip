# RedNote session cookie (get from browser DevTools > Application > Cookies)
REDNOTE_COOKIE=
REDNOTE_XSEC_TOKEN=""


# Whisper model size: tiny, base, small, medium, large
WHISPER_MODEL=medium

# Output directory (default: ./data/output)
OUTPUT_DIR=./data/output

# How many seconds to cut from the beginning of the video (to remove intro)
CUT_INTRO_SECONDS=0.5

# How many seconds to cut from the end of the video (to remove RedNote outro)
CUT_OUTRO_SECONDS=3.0

# Zernio API credentials for TikTok Uploads
ZERNIO_API_KEY=
ZERNIO_TIKTOK_ACCOUNT_ID=

# Edge TTS voice (Vietnamese)
# Female: vi-VN-HoaiMyNeural | Male: vi-VN-NamMinhNeural
TTS_VOICE=vi-VN-HoaiMyNeural

# TTS speech rate (e.g., +0%, -10%, +20%)
TTS_RATE=+0%

# Original audio volume when mixed with TTS (0.0 - 1.0)
ORIGINAL_AUDIO_VOLUME=0.2

# Subtitle style
SUBTITLE_FONT_SIZE=24
SUBTITLE_FONT_COLOR=white
SUBTITLE_OUTLINE_COLOR=black
SUBTITLE_POSITION=bottom

# Gemini API for Translation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash