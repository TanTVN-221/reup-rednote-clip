{
  "name": "reup-rednote-clip",
  "version": "1.0.0",
  "description": "Download RedNote (Xiaohongshu) clips, translate Chinese to Vietnamese, and re-upload to TikTok",
  "type": "module",
  "main": "src/cli.js",
  "bin": {
    "rednote": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "dev": "node --watch src/cli.js"
  },
  "keywords": [
    "rednote",
    "xiaohongshu",
    "tiktok",
    "translate",
    "chinese",
    "vietnamese"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.8.0",
    "@zernio/node": "^0.2.233",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "fluent-ffmpeg": "^2.1.3",
    "google-translate-api-x": "^10.7.1",
    "google-tts-api": "^2.0.2",
    "node-edge-tts": "^1.2.10",
    "ora": "^8.0.1",
    "playwright": "^1.45.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "srt-parser-2": "^1.2.3",
    "tesseract.js": "^5.1.0",
    "whisper-node": "^1.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
